[Unit]
Description=OpenNGS cloud dataset integrity verifier
After=network-online.target openngs.service
[Service]
User=openngs
Group=openngs
WorkingDirectory=/opt/openngs
EnvironmentFile=/var/lib/openngs/runtime.env
ExecStart=/opt/openngs/runtime/bin/python -m backend.cloud_data
Restart=always
RestartSec=10
MemoryMax=384M
CPUQuota=20%
TasksMax=32
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/openngs /var/cache/openngs
[Install]
WantedBy=multi-user.target
