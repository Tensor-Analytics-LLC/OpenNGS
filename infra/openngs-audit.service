[Unit]
Description=OpenNGS immutable audit-chain checkpoints
After=network-online.target openngs.service
[Service]
User=openngs
Group=openngs
WorkingDirectory=/opt/openngs
EnvironmentFile=/var/lib/openngs/runtime.env
ExecStart=/opt/openngs/runtime/bin/python -m backend.audit_anchor
Restart=always
RestartSec=10
MemoryMax=192M
CPUQuota=10%
TasksMax=32
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/openngs /var/cache/openngs
[Install]
WantedBy=multi-user.target
